# Better Auth
ADMIN_EMAIL="you@example.com"
BETTER_AUTH_SECRET="replace-with-a-random-value-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# PostgreSQL connection string for Better Auth users and sessions
DATABASE_URL="postgres://user:password@host/database?sslmode=require"

# Optional: uncomment and configure both variables to enable Google OAuth.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
