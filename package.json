{
  "name": "suateneskoc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun run --bun next build",
    "bundle:analyze": "bun run --bun next analyze",
    "bundle:analyze:output": "bun run --bun next analyze --output",
    "check:all": "bun run format:check && bun run lint && bun run type:check && bun run content:check && bun run knip && bun run build",
    "check:fast": "bun run format:check && bun run lint && bun run type:check",
    "clean": "bun run --bun rimraf .next out dist coverage",
    "content:check": "bun run --bun scripts/check-content.ts",
    "dev": "bun run --bun next dev",
    "env:pull": "([ -f .vercel/project.json ] || bun run --bun vercel link) && bun run --bun vercel env pull .env.local",
    "format": "bun run --bun prettier --write .",
    "format:check": "bun run --bun prettier --check .",
    "lint": "bun run --bun eslint --max-warnings=0",
    "knip": "bunx --bun knip --no-progress",
    "prepare": "husky",
    "reinstall": "bun run --bun rimraf node_modules && bun install --frozen-lockfile",
    "start": "bun run --bun next start",
    "type:check": "bun run --bun tsc --noEmit"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^65.2.0"
  }
}
